{
  "manifest_version": 3,
  "name": "小宇宙 Digest v2.0",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "把小宇宙播客变成学习资料：paraformer-v2 语音转写、AI 概览、重点讲解与时间戳笔记。",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.xiaoyuzhoufm.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://*.aliyuncs.com/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "打开小宇宙 Digest v2.0",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaoyuzhoufm.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/assets/*.js"],
      "matches": ["https://www.xiaoyuzhoufm.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
